# Copy this file to hw4/.env (or to a folder above hw4/) and fill in real values.
# Never commit the real .env file. It is listed in .gitignore.

# Portkey API key used to call the OpenAI model (gpt-5.6-sol) through https://api.portkey.ai/v1
PORTKEY_API_KEY=your-portkey-api-key-here

# Any long random string; used to sign login session cookies
SESSION_SECRET=replace-with-a-long-random-string
