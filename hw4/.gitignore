# Local data pack: never commit (graders place their own copy here)
data/
*.db
*.sqlite
*.sqlite3
data.zip

# Secrets: never commit the real .env (the .env.example template is committed)
.env
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.pyc

# Node / build output
node_modules/
dist/

# OS / editor
.DS_Store
.claude/
